{
  "id": {
    "type": "string",
    "label": "Id"
  },
  "exams_srial": {
    "type": "string",
    "label": "Serial",
    "maxLength": 50,
    "placeholder": "Enter question serial (e.g., 01)",
    "required": true
  },
  "exams_teach": {
    "type": "string",
    "label": "Teaching Material / Lesson",
    "maxLength": 50,
    "placeholder": "Select teaching material",
    "required": true
  },
  "exams_cname": {
    "type": "string",
    "label": "Question / Quiz Task",
    "maxLength": 200,
    "minLength": 2,
    "placeholder": "Enter question (e.g., What sound does 'A' make? Or: 2 + 3 = ?)",
    "required": true
  },
  "exams_answr": {
    "type": "string",
    "label": "Expected Answer / Solution",
    "maxLength": 500,
    "placeholder": "Enter the expected answer or solution...",
    "required": false
  },
  "exams_notes": {
    "type": "string",
    "label": "Teacher Guidance / Hint",
    "maxLength": 100,
    "placeholder": "Teacher hints or grading notes",
    "required": false
  },
  "exams_marks": {
    "type": "number",
    "label": "Marks",
    "default": 1,
    "placeholder": "Enter marks for this question",
    "required": true
  },
  "exams_stats": {
    "type": "boolean",
    "label": "Evaluated / Passed",
    "default": false,
    "placeholder": "Select status",
    "required": false
  },
  "exams_actve": {
    "type": "boolean",
    "label": "Active",
    "default": true,
    "required": false
  },
  "exams_crusr": {
    "type": "string",
    "label": "Created By"
  },
  "exams_crdat": {
    "type": "string",
    "label": "Created Date"
  },
  "exams_upusr": {
    "type": "string",
    "label": "Updated By"
  },
  "exams_updat": {
    "type": "string",
    "label": "Updated Date"
  },
  "exams_rvnmr": {
    "type": "number",
    "label": "Rev Number",
    "default": 1
  }
}
