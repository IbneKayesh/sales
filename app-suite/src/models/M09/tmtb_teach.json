{
  "id": {
    "type": "string",
    "label": "Id"
  },
  "teach_srial": {
    "type": "string",
    "label": "Serial",
    "maxLength": 50,
    "placeholder": "Enter serial (e.g., 01)",
    "required": true
  },
  "teach_teach": {
    "type": "string",
    "label": "Parent Lesson / Topic",
    "maxLength": 50,
    "placeholder": "Select parent lesson (optional)",
    "required": false
  },
  "teach_cname": {
    "type": "string",
    "label": "Lesson / Topic Title",
    "maxLength": 50,
    "minLength": 2,
    "placeholder": "Enter lesson title (e.g., Alphabet Fun - Letter A)",
    "required": true
  },
  "teach_descr": {
    "type": "string",
    "label": "Lesson Content / Reading Material",
    "maxLength": 500,
    "placeholder": "Enter reading text, sight words, or story for kids...",
    "required": false
  },
  "teach_notes": {
    "type": "string",
    "label": "Teacher Guidance / Notes",
    "maxLength": 100,
    "placeholder": "Teacher tips (e.g., Use picture flashcards)",
    "required": false
  },
  "teach_ttype": {
    "type": "string",
    "label": "Subject",
    "maxLength": 50,
    "placeholder": "Select or enter subject",
    "required": false
  },
  "teach_tagno": {
    "type": "string",
    "label": "Grade / Level",
    "maxLength": 100,
    "placeholder": "e.g., Kindergarten, Grade 1, Age 4-6",
    "required": false
  },
  "teach_reads": {
    "type": "number",
    "label": "Practice Reads",
    "default": 1,
    "placeholder": "Number of practice reads",
    "required": false
  },
  "teach_marks": {
    "type": "number",
    "label": "Reward Marks",
    "default": 1,
    "placeholder": "Enter reward marks / points",
    "required": true
  },
  "teach_stats": {
    "type": "boolean",
    "label": "Ready for Kids",
    "default": true,
    "placeholder": "Select status",
    "required": false
  },
  "teach_actve": {
    "type": "boolean",
    "label": "Active",
    "default": true,
    "required": false
  },
  "teach_crusr": {
    "type": "string",
    "label": "Created By"
  },
  "teach_crdat": {
    "type": "string",
    "label": "Created Date"
  },
  "teach_upusr": {
    "type": "string",
    "label": "Updated By"
  },
  "teach_updat": {
    "type": "string",
    "label": "Updated Date"
  },
  "teach_rvnmr": {
    "type": "number",
    "label": "Rev Number",
    "default": 1
  }
}
