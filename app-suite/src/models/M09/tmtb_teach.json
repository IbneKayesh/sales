{
  "id": {
    "type": "string",
    "label": "Id"
  },
  "teach_teach": {
    "type": "string",
    "label": "Parent Topic",
    "maxLength": 50,
    "placeholder": "Select parent topic (optional)",
    "required": false
  },
  "teach_srial": {
    "type": "number",
    "label": "Serial",
    "placeholder": "Enter serial (e.g., 1)",
    "required": true
  },
  "teach_cname": {
    "type": "string",
    "label": "Lesson Title",
    "maxLength": 50,
    "minLength": 2,
    "placeholder": "Enter lesson title",
    "required": true
  },
  "teach_descr": {
    "type": "string",
    "label": "Lesson Content",
    "maxLength": 500,
    "placeholder": "Enter lesson content",
    "required": false
  },
  "teach_notes": {
    "type": "string",
    "label": "Teacher Notes",
    "maxLength": 100,
    "placeholder": "Teacher notes",
    "required": false
  },
  "teach_reads": {
    "type": "number",
    "label": "Practice Reads",
    "default": 1,
    "placeholder": "Number of practice reads",
    "required": false
  },
  "teach_marks": {
    "type": "number",
    "label": "Reward Marks",
    "default": 1,
    "placeholder": "Enter reward marks / points",
    "required": true
  }
